# ARM resource ID of the VM to control.
GUARDIAN_VM_RESOURCE_ID=/subscriptions/.../resourceGroups/.../providers/Microsoft.Compute/virtualMachines/...

# Where the VM's own reverse proxy (Caddy) answers once it's up.
GUARDIAN_VM_ORIGIN=http://<vm-public-ip>:443

# Storage account backing the guardian's state (session log, flags). Access
# is via the Container App's managed identity - no key here.
GUARDIAN_STORAGE_ACCOUNT=easyragguardian
# GUARDIAN_TABLE_NAME=guardianstate

# Product decision, not a technical default - see docs/azure-deployment-plan.md
# for the reasoning (confirmed 2026-09-28: cost difference between 10h and
# 40h is ~0.15 $/month at Spot ARM pricing, so the cap is sized for headroom
# against abnormal usage, not for cost). Required: no silent fallback.
GUARDIAN_MAX_MONTHLY_HOURS=40

# GUARDIAN_IDLE_SHUTDOWN_MINUTES=12
# GUARDIAN_POLL_INTERVAL_SECONDS=30
# GUARDIAN_PROXY_TIMEOUT_SECONDS=300

# Shared secret the budget Action Group's webhook must send as ?token=... -
# not real auth, just enough to stop randoms flipping the budget flag.
# GUARDIAN_BUDGET_WEBHOOK_TOKEN=
