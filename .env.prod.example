# Real values for docker-compose.prod.yml (docs/DEPLOYMENT.md). Copy to
# `.env.prod` on the target host, fill in, never commit it.
#
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d

# A real random secret - e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`
SECRET_KEY=

# Comma-separated, no scheme (e.g. easyrag.example.com)
ALLOWED_HOSTS=

# Comma-separated, with scheme (e.g. https://easyrag.example.com)
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Optional - Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave
# empty to build the frontend without GA (see front/app/root.tsx).
VITE_GA_MEASUREMENT_ID=

# Optional - GA4 Measurement Protocol API secret (GA4 admin > Data streams >
# your stream > Measurement Protocol API secrets > Create). Lets the
# frontend's SSR server report a page_request event directly, bypassing
# adblockers that stop the client-side gtag.js script. Leave empty to skip
# it - a real secret, unlike the measurement ID above, never baked into the
# image (see front/app/root.tsx).
GA_MP_API_SECRET=
