# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
# Comma-separated hosts, required when DEBUG=False.
# ALLOWED_HOSTS=easyrag.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Postgres with pgvector. Falls back to local sqlite (no vector search) if unset.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/easyrag

# Shared cache for request throttling. Falls back to an in-memory cache if unset
# (fine for a single-process runserver).
# REDIS_URL=redis://localhost:6379/1

# RAG (all local, no API keys). Defaults shown - uncomment to override.
# OLLAMA_URL=http://localhost:11434
# RAG_LLM_MODEL=llama3.2:3b
# OLLAMA_KEEP_ALIVE=-1
# RAG_MAX_TOKENS=600
# RAG_MAX_CONCURRENT_CHATS=4
# RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# RAG_EMBEDDING_QUERY_PREFIX=query:
# RAG_EMBEDDING_PASSAGE_PREFIX=passage:
# RAG_TOP_K=8
# RAG_PROMPT_CONTEXT_CHARS=2800
# RAG_SIMILARITY_THRESHOLD=0.72
# RAG_CHUNK_TOKENS=350
# RAG_CHUNK_OVERLAP=64

# Public API rate limits (per client IP; see docs/DEPLOYMENT.md for a note on
# X-Forwarded-For behind a proxy). Defaults shown - uncomment to override.
# RAG_CHAT_THROTTLE=10/min
# RAG_READ_THROTTLE=120/min

# Number of trusted reverse-proxy hops in front of this app. 0 (default) keys
# rate limiting on the raw connecting socket - safe with no proxy, but wrong
# (undercounts hops) behind one. Set to 1 for the single-proxy setup in
# docs/DEPLOYMENT.md, so the throttle reads the real client IP out of
# X-Forwarded-For instead of trusting whatever a client put there itself.
# TRUSTED_PROXY_COUNT=0

# Caps the client-supplied `history` field's total size (chars) once it's
# folded into the prompt - independent of RAG_PROMPT_CONTEXT_CHARS, which only
# budgets retrieved passages.
# RAG_MAX_HISTORY_CHARS=4000
