# Django settings
SECRET_KEY=your-secret-key-here
# Dedicated JWT signing key - keep it different from SECRET_KEY so a leak/
# rotation of one doesn't force rotating the other. Required when DEBUG=False.
JWT_SIGNING_KEY=your-jwt-signing-key-here
DEBUG=True
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cache (shared across all app workers/containers - required for OTP codes
# and rate-limiting to work correctly with more than one worker; falls back
# to a local in-memory cache if unset, which only works for a single process)
REDIS_URL=redis://localhost:6379/1

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client, type
# "Web application"). Must be the same client as VITE_GOOGLE_CLIENT_ID in
# front/.env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password

# RAG (all local, no API keys). Defaults shown - uncomment to override.
# OLLAMA_URL=http://localhost:11434
# RAG_LLM_MODEL=llama3.1
# RAG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# RAG_TOP_K=5
# RAG_SIMILARITY_THRESHOLD=0.6
